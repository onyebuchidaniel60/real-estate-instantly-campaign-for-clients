    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    const rawTitle = (item.json.title || '').toString().trim();\n\n    let firstName = '';\n    let lastName = '';\n\n    // If the title starts with a number, leave names blank\n    if (/^\\d/.test(rawTitle)) {\n        return {\n            json: {\n                firstName: '',\n                lastName: ''\n            }\n        };\n    }\n\n    // Extract @username inside parentheses if present\n    const atWithParenMatch = rawTitle.match(/\\(@([^\\s)]+)\\)/);\n\n    let cleanedTitle = rawTitle;\n\n    if (atWithParenMatch) {\n        // Remove the (@username) section for name extraction\n        cleanedTitle = rawTitle.replace(atWithParenMatch[0], '').trim();\n    }\n\n    // Remove any remaining parentheses and content\n    cleanedTitle = cleanedTitle.replace(/\\([^)]*\\)/g, '').trim();\n\n    // Split title into words\n    const words = cleanedTitle.split(/\\s+/);\n\n    if (words.length > 0) {\n        firstName = words[0] || '';\n    }\n\n    if (words.length > 1) {\n        lastName = words[1] || '';\n    }\n\n    return {\n        json: {\n            firstName,\n            lastName\n        }\n    };\n});\n"
      },
